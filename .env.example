# Tappsy Backend Environment Configuration
# Set these variables in your GlassFish / Payara JVM environment or system environment.

# MySQL Database Connection
DB_URL=jdbc:mysql://localhost:3306/tappsy?useSSL=false&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Application Base URLs
# Publicly reachable base URL sent to mobile/web clients for media assets (e.g., https://api.example.com)
PUBLIC_BASE_URL=http://localhost:8080
# Internal server base URL used to verify uploaded profile assets
LOCAL_BASE_URL=http://localhost:8080
# Deployed web application context path
APP_CONTEXT_PATH=/TappsyBackEnd
